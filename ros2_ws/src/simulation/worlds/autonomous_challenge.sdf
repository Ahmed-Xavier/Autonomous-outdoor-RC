<?xml version="1.0"?>
<sdf version="1.9"><world name="autonomous_challenge">
<physics name="1ms" type="ode"><max_step_size>.001</max_step_size><real_time_factor>1</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/><plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/><plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
<scene><ambient>.65 .65 .65 1</ambient><background>.72 .75 .78 1</background><shadows>false</shadows></scene><light name="sun" type="directional"><direction>-.3 -.4 -1</direction><diffuse>1 1 1 1</diffuse></light>
<!-- Approximate engineering test fixture, NOT an official Shell Eco-marathon course. Spawn at (-5,-15), heading +X. -->
<model name="ground"><static>true</static><link name="l"><collision name="c"><pose>0 0 -.12 0 0 0</pose><geometry><box><size>100 70 .2</size></box></geometry></collision><visual name="v"><pose>0 0 -.12 0 0 0</pose><geometry><box><size>100 70 .2</size></box></geometry><material><diffuse>.58 .60 .61 1</diffuse></material></visual></link></model>
<model name="road_bottom"><static>true</static><pose>0 -15 0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>60 6 .04</size></box></geometry></collision><visual name="v"><geometry><box><size>60 6 .04</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual></link></model>
<model name="road_top"><static>true</static><pose>0 15 0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>60 6 .04</size></box></geometry></collision><visual name="v"><geometry><box><size>60 6 .04</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual></link></model>
<model name="road_left"><static>true</static><pose>-30 0 0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>6 30 .04</size></box></geometry></collision><visual name="v"><geometry><box><size>6 30 .04</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual></link></model>
<model name="road_right"><static>true</static><pose>30 0 0 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>6 30 .04</size></box></geometry></collision><visual name="v"><geometry><box><size>6 30 .04</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual></link></model>
<model name="edge_bottom_outer"><static>true</static><pose>0 -18 .025 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>60 .12 .02</size></box></geometry><material><diffuse>.95 .95 .95 1</diffuse></material></visual></link></model>
<model name="edge_bottom_inner"><static>true</static><pose>0 -12 .025 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>60 .12 .02</size></box></geometry><material><diffuse>.95 .95 .95 1</diffuse></material></visual></link></model>
<model name="edge_top_outer"><static>true</static><pose>0 18 .025 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>60 .12 .02</size></box></geometry><material><diffuse>.95 .95 .95 1</diffuse></material></visual></link></model>
<model name="edge_top_inner"><static>true</static><pose>0 12 .025 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>60 .12 .02</size></box></geometry><material><diffuse>.95 .95 .95 1</diffuse></material></visual></link></model>
<model name="start_finish_line"><static>true</static><pose>-10 -15 .035 0 0 1.5707963</pose><link name="l"><visual name="v"><geometry><box><size>6 .15 .02</size></box></geometry><material><diffuse>1 .82 .02 1</diffuse></material></visual></link></model>
<model name="stop_line"><static>true</static><pose>20 -15 .035 0 0 1.5707963</pose><link name="l"><visual name="v"><geometry><box><size>6 .15 .02</size></box></geometry><material><diffuse>1 .32 .02 1</diffuse></material></visual></link></model>
<model name="stop_sign"><static>true</static><pose>22 -11.3 1.3 0 0 0</pose><link name="l"><visual name="pole"><geometry><cylinder><radius>.045</radius><length>2.6</length></cylinder></geometry><material><diffuse>.7 .7 .7 1</diffuse></material></visual><visual name="board"><pose>-.02 0 .15 0 0 0</pose><geometry><box><size>.12 .85 .85</size></box></geometry><material><diffuse>.8 .02 .02 1</diffuse></material></visual></link></model>
<model name="obstacle_1"><static>true</static><pose>8 -13 .3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>.18</radius><length>.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.18</radius><length>.6</length></cylinder></geometry><material><diffuse>.95 .36 .02 1</diffuse></material></visual></link></model>
<model name="obstacle_2"><static>true</static><pose>14 -17 .3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>.18</radius><length>.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.18</radius><length>.6</length></cylinder></geometry><material><diffuse>.95 .36 .02 1</diffuse></material></visual></link></model>
<model name="obstacle_3"><static>true</static><pose>0 12.7 .3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>.18</radius><length>.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.18</radius><length>.6</length></geometry><material><diffuse>.95 .36 .02 1</diffuse></material></visual></link></model>
</world></sdf>