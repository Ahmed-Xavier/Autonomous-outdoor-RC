<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="silesia_ring">
    <static>true</static>
    <link name="track">
      <!-- Simplified, scaled track ribbon: 3,636 m centreline and 12 m nominal width.
           This is not a survey-grade reconstruction; replace with surveyed/CAD geometry when available. -->
      <visual name="track_surface">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://silesia_ring/meshes/silesia_ring.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="track_surface_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://silesia_ring/meshes/silesia_ring.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
