<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rc_car">

  <!-- ===================== MEASURED (from you) ===================== -->
  <xacro:property name="wheel_radius"   value="0.025"/>  <!-- 5 cm diameter -->
  <xacro:property name="wheel_width"    value="0.015"/>
  <xacro:property name="wheel_base"     value="0.185"/>  <!-- rear axle -> front axle -->
  <xacro:property name="track_width"    value="0.11"/>   <!-- left wheel centre -> right wheel centre -->
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_height" value="0.055"/>

  <!-- ===================== ASSUMED (measure later) ================= -->
  <xacro:property name="chassis_width"     value="0.08"/>   <!-- not given: must be < track_width - wheel_width -->
  <xacro:property name="chassis_x_offset"  value="0.0925"/> <!-- chassis centre, in front of rear axle (here: centred between axles) -->
  <xacro:property name="ground_clearance"  value="0.010"/>  <!-- chassis bottom above ground -->
  <xacro:property name="chassis_mass"      value="1.0"/>    <!-- kg -->
  <xacro:property name="wheel_mass"        value="0.05"/>   <!-- kg -->
  <xacro:property name="steer_limit"       value="0.5"/>    <!-- rad, to calibrate with the servo -->

  <!-- ===================== Inertia macros ========================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12.0}" iyz="0"
             izz="${m*(x*x+y*y)/12.0}"/>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="m r w">
    <!-- cylinder, spin axis = link Y (after the roll below) -->
    <inertia ixx="${m*(3*r*r+w*w)/12.0}" ixy="0" ixz="0"
             iyy="${m*r*r/2.0}" iyz="0"
             izz="${m*(3*r*r+w*w)/12.0}"/>
  </xacro:macro>

  <!-- ===================== Wheel macro ============================= -->
  <!-- Wheel link frame: Y = spin axis. Cylinder is rolled 90 deg to match. -->
  <xacro:macro name="wheel" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" w="${wheel_width}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Small link that carries the steering rotation of a front wheel -->
  <xacro:macro name="steer_link" params="name">
    <link name="${name}">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ===================== Links & joints ========================== -->
  <!-- base_footprint: on the ground, under the REAR AXLE centre (x forward, y left, z up) -->
  <link name="base_footprint"/>

  <!-- base_link: rear axle centre, at wheel-axle height -->
  <link name="base_link"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Chassis -->
  <link name="chassis">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </inertial>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <!-- z: chassis bottom sits ground_clearance above ground; base_link is wheel_radius above ground -->
    <origin xyz="${chassis_x_offset} 0 ${ground_clearance + chassis_height/2 - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Rear wheels (driven, no steering) -->
  <xacro:wheel name="rear_left_wheel"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 ${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel name="rear_right_wheel"/>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 ${-track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front steering knuckles (rotate around Z) -->
  <xacro:steer_link name="front_left_steer"/>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer"/>
    <origin xyz="${wheel_base} ${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-steer_limit}" upper="${steer_limit}" effort="1.0" velocity="3.0"/>
  </joint>

  <xacro:steer_link name="front_right_steer"/>
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer"/>
    <origin xyz="${wheel_base} ${-track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-steer_limit}" upper="${steer_limit}" effort="1.0" velocity="3.0"/>
  </joint>

  <!-- Front wheels (free spin, steered) -->
  <xacro:wheel name="front_left_wheel"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel name="front_right_wheel"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================== Sensor frames (TODO: real positions) ==== -->
  <!-- IMU: front, on the centreline, 3.5 cm from the middle of the front wheels.
       ASSUMED: ahead of the front axle (use a negative value if it is behind).
       Height assumed = top of chassis. rpy = fixed mount rotation, calibrate later. -->
  <xacro:property name="imu_dx" value="0.035"/>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${wheel_base + imu_dx} 0 ${ground_clearance + chassis_height - wheel_radius}" rpy="0 0 ${-pi/2}"/>
  </joint>

  <!-- GPS: position barely matters at this accuracy, so it sits on top of the chassis centre -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="chassis"/>
    <child link="gps_link"/>
    <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>

</robot>
