<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_bringup</name>
  <version>0.0.1</version>
  <description>Bringup launch files for the autonomous outdoor RC car</description>
  <maintainer email="ahmed@example.com">ahmed</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>vehicle_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
