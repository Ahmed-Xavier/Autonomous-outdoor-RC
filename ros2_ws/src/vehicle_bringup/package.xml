<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_bringup</name>
  <version>0.0.1</version>
  <description>Bringup launch files for the autonomous outdoor RC car</description>
  <maintainer email="ahmed@example.com">ahmed</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>vehicle_description</exec_depend>
  <exec_depend>vehicle_drivers</exec_depend>
  <exec_depend>localization</exec_depend>
  <exec_depend>vehicle_control</exec_depend>
  <exec_depend>navigation</exec_depend>
  <exec_depend>nmea_navsat_driver</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
