+def _floats(text, n):
+    vals = [float(v) for v in (text or '').split()]
+    return (vals + [0.0] * n)[:n]
+
+
+def load_obstacles(world_file):
+    """Read static primitive models (cylinder/box/sphere) from a Gazebo world SDF.
+
+    Returns dicts: name, kind, pose (x, y, z, yaw), size (x, y, z), rgba.
+    Models with mesh geometry (e.g. the track) and <include> tags are skipped.
+    Link/visual pose offsets and roll/pitch are ignored.
+    """
+    world = ET.parse(world_file).getroot().find('world')
+    out = []
+    for model in world.findall('model'):
+        name = model.get('name')
+        if name == 'ground_plane':
+            continue
+        x, y, z, _r, _p, yaw = _floats(model.findtext('pose'), 6)
+        for visual in model.iter('visual'):
+            geom = visual.find('geometry')
+            if geom is None:
+                continue
+            if geom.find('cylinder') is not None:
+                c = geom.find('cylinder')
+                d = 2.0 * float(c.findtext('radius'))
+                kind, size = 'cylinder', (d, d, float(c.findtext('length')))
+            elif geom.find('box') is not None:
+                kind = 'box'
+                size = tuple(_floats(geom.find('box').findtext('size'), 3))
+            elif geom.find('sphere') is not None:
+                d = 2.0 * float(geom.find('sphere').findtext('radius'))
+                kind, size = 'sphere', (d, d, d)
+            else:
+                continue
+            rgba = _floats(visual.findtext('material/diffuse'), 4)
+            if rgba[3] == 0.0:
+                rgba = [0.6, 0.6, 0.6, 1.0]
+            out.append({'name': name, 'kind': kind, 'pose': (x, y, z, yaw),
+                        'size': size, 'rgba': rgba})
+            break  # one marker per model
+    return out
+
+
